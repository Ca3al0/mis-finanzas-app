<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MisFinanzas">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Actividad Flotante Rápida para hablar con el Agente directamente desde el Widget -->
        <activity
            android:name=".WidgetAgentDialogActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_agent_activity_label"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.MisFinanzas.WidgetDialog"
            android:windowSoftInputMode="adjustResize" />

        <!-- Receptor del Widget de Pantalla de Inicio (Home Screen Widget) -->
        <receiver
            android:name=".MisFinanzasAppWidgetProvider"
            android:exported="true"
            android:label="Mis Finanzas • Agente y Saldo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.misfinanzas.personal.a36.ACTION_CHECK_LAST_PURCHASE" />
                <action android:name="com.misfinanzas.personal.a36.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mis_finanzas_widget_info" />
        </receiver>

        <service
            android:name=".BankNotificationListener"
            android:exported="true"
            android:label="@string/notif_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
